{
  "name": "wayfinder",
  "displayName": "WayFinder",
  "description": "Focus VS Code workbench destinations from one searchable selector.",
  "version": "0.0.1",
  "publisher": "local-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wayfinder.openSelector",
        "title": "WayFinder: Focus..."
      }
    ],
    "keybindings": [
      {
        "command": "wayfinder.openSelector",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "configuration": {
      "title": "WayFinder",
      "properties": {
        "wayfinder.customFocusTargets": {
          "type": "array",
          "default": [],
          "description": "Additional focus targets to show in the WayFinder selector.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "command"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "The label shown in the selector."
              },
              "description": {
                "type": "string",
                "description": "Optional secondary text shown beside the label."
              },
              "detail": {
                "type": "string",
                "description": "Optional detail text shown below the label."
              },
              "icon": {
                "type": "string",
                "description": "Optional codicon name, for example `symbol-misc`."
              },
              "command": {
                "type": "string",
                "description": "The command to execute when the target is selected."
              },
              "args": {
                "type": "array",
                "description": "Optional JSON-compatible arguments passed to the command."
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test tests/project.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}
